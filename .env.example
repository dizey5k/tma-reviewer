# URL локального сервера Ollama
OLLAMA_URL=http://localhost:11434/api/chat

# Модель (qwen2.5-coder:3b для быстрой проверки, qwen2.5-coder:7b или tma-reviewer для глубокой)
OLLAMA_MODEL=qwen2.5-coder:3b

# Параметры генерации
OLLAMA_TEMPERATURE=0.05
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=180

# Git настройки
TARGET_BRANCH=origin/main
MAX_DIFF_CHARS=24000

# Игнорируемые паттерны через запятую
IGNORE_PATTERNS=package-lock.json,pnpm-lock.yaml,yarn.lock,*.svg,*.png,*/alembic/versions/*