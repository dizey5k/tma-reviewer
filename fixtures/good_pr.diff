diff --git a/frontend/src/components/TaskItem.tsx b/frontend/src/components/TaskItem.tsx
index 12a4b5c..55f6a1b 100644
--- a/frontend/src/components/TaskItem.tsx
+++ b/frontend/src/components/TaskItem.tsx
@@ -1,10 +1,20 @@
 import React from 'react';
+import { useTaskStore } from '../store/useTaskStore';
 
 export const TaskItem: React.FC<{ id: string; title: string }> = ({ id, title }) => {
+  const deleteTask = useTaskStore((state) => state.deleteTask);
+
+  const handleDelete = () => {
+    window.Telegram.WebApp.showAlert(`Задача ${title} удалена!`);
+    deleteTask(id);
+  };
+
   return (
     <div style={{ backgroundColor: 'var(--tg-theme-bg-color)', color: 'var(--tg-theme-text-color)' }}>
       <span>{title}</span>
+      <button onClick={handleDelete}>Удалить</button>
     </div>
   );
 };
